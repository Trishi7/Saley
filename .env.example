# Saley v2 — every variable the code reads, with its default. Human-only values use <REQUIRED: ...>.
# Copy to .env. Never commit .env. tests/test_env_example.py checks this file against the code.

# --- core ---
SALEY_ENV=dev
SALEY_TZ=Asia/Kolkata
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://saley:saley@localhost:5432/saley
DATABASE_URL_RO=postgresql+psycopg://saley_ro:saley_ro@localhost:5432/saley
# Migrations run as saley_admin when set; empty = use DATABASE_URL.
DATABASE_URL_ADMIN=
# Tests use this database; empty = DATABASE_URL with the database name + "_test". Never the real database.
TEST_DATABASE_URL=

# --- discord ---
DISCORD_BOT_TOKEN=<REQUIRED: dev bot token>
DISCORD_GUILD_ID=<REQUIRED: server id>
DISCORD_TEST_CHANNEL_ID=<REQUIRED: the separate test channel>
DISCORD_SALES_CHANNEL_ID=
DISCORD_APPROVER_IDS=
DISCORD_INSTRUCT_IDS=
TEST_MODE=true
DISCORD_TEST_USER_IDS=

# --- google sheets ---
GTM_SHEET_ID=<REQUIRED: id of the GTM Playbook COPY for local tests>
GTM_SHEET_IS_COPY=true
GOOGLE_SERVICE_ACCOUNT_FILE=<REQUIRED: path to the service account json, outside the repo>
SHEET_SYNC_SECONDS=60
EMAIL_WRITE_ALLOWED=false
UNDO_MINUTES=10
OWNER_DEFAULT_LINKEDIN=sid
OWNER_DEFAULT_RESEARCH=vaishnavi

# --- llm (decision D28: Anthropic API directly; R1 makes no LLM calls) ---
ANTHROPIC_API_KEY=<REQUIRED: Anthropic API key (not used in R1, may stay empty)>
LLM_SMALL=claude-haiku-4-5
LLM_MID=claude-sonnet-4-5
LLM_DAILY_CALL_CAP=400
LLM_CACHE_DAYS=7

# --- egress ---
EGRESS_ALLOWLIST=sheets.googleapis.com,oauth2.googleapis.com,discord.com,api.anthropic.com,api.openalex.org,export.arxiv.org,news.google.com,imap.gmail.com
EGRESS_BLOCKLIST=linkedin.com
EGRESS_RATE_PER_HOST_PER_MIN=30
HTTP_TIMEOUT_SECONDS=20

# --- web ---
WEB_PORT=8090
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
WEB_ALLOWED_EMAILS=
WEB_SESSION_SECRET=<REQUIRED: random 32+ chars>
DEV_USER_EMAIL=dev@membrane.local

# --- email sending (OFF until a decision; drafts only) ---
EMAIL_SEND_ENABLED=false
EMAIL_SINK_PATH=data/outbox

# --- mail (Membrane cc mailbox, read-only) ---
MAIL_IMAP_HOST=imap.gmail.com
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_POLL_MINUTES=10

# --- apollo (pipeline to build; off until then) ---
APOLLO_ENABLED=false
APOLLO_API_KEY=
APOLLO_MONTHLY_CREDIT_CAP=0

# --- RETIRED ---
# OPENROUTER_API_KEY  (R1, decision D28: the LLM is the Anthropic API directly)

# Saley v2 — every variable the code reads, with its default. Human-only values use <REQUIRED: ...>.
# Copy to .env. Never commit .env. tests/test_env_example.py checks this file against the code.

# --- core ---
SALEY_ENV=dev
SALEY_TZ=Asia/Kolkata
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://saley:saley@localhost:5432/saley
DATABASE_URL_RO=postgresql+psycopg://saley_ro:saley_ro@localhost:5432/saley
# Migrations run as saley_admin when set; empty = use DATABASE_URL.
DATABASE_URL_ADMIN=
# Tests use this database; empty = DATABASE_URL with the database name + "_test". Never the real database.
TEST_DATABASE_URL=

# --- discord ---
DISCORD_BOT_TOKEN=<REQUIRED: dev bot token>
DISCORD_GUILD_ID=<REQUIRED: server id>
DISCORD_TEST_CHANNEL_ID=<REQUIRED: the separate test channel>
DISCORD_SALES_CHANNEL_ID=
DISCORD_APPROVER_IDS=
DISCORD_INSTRUCT_IDS=
TEST_MODE=true
DISCORD_TEST_USER_IDS=
# D130: the blocker note posts this many minutes after the weekly pack (Mon 14:00 + 120 = 16:00 IST).
BLOCKER_NOTE_DELAY_MINUTES=120
# D132: bot caps per person per day (DMs and @mentions together), and the gap between two posts for one person.
BOT_POSTS_PER_PERSON_PER_DAY=4
BOT_POST_GAP_MINUTES=120
# D126: delivery window per person in IST, short:HH:MM-HH:MM;short2:... ("24:00" ends the day).
USER_HOURS=sid:14:00-24:00
# D128: the daily brief is a DM at this IST time on weekdays. DM_ENABLED is off until the human says on.
DAILY_BRIEF_TIME=14:00
DM_ENABLED=false
# Only these people get a DM. Empty = nobody.
DM_USERS=sid,vaishnavi,kushal,trishi
# D135: short:discord id;... fills users.discord_id when the bot starts. Empty = leave it alone.
DISCORD_USER_MAP=

# --- google sheets ---
GTM_SHEET_ID=<REQUIRED: id of the GTM Playbook COPY for local tests>
GTM_SHEET_IS_COPY=true
GOOGLE_SERVICE_ACCOUNT_FILE=<REQUIRED: path to the service account json, outside the repo>
SHEET_SYNC_SECONDS=60
EMAIL_WRITE_ALLOWED=false
FIND_PEOPLE_ENABLED=false
UNDO_MINUTES=5
SHEET_WRITE_ENABLED=false
SHEET_PUSH_SECONDS=2
SHEET_TEST_TAB=SALEY_TEST
ACT_COOLDOWN_SECONDS=2
OWNER_DEFAULT_LINKEDIN=sid
OWNER_DEFAULT_RESEARCH=vaishnavi
# Meeting-note owner names: short:name|name,short2:name. First word of the owner, exact (D92).
TEAM_NAME_ALIASES=sid:Siddarth,Siddharth,Sid;vaishnavi:Vaishnavi,VR;kushal:Kushal;trishi:Trishi

# --- llm (decision D28: Anthropic API directly; R3 scorer and hints call it, D72, D79) ---
ANTHROPIC_API_KEY=<REQUIRED: Anthropic API key (empty = rules scorer, no hints)>
LLM_SMALL=claude-haiku-5-5
LLM_MID=claude-sonnet-5-5
LLM_DAILY_CALL_CAP=400
LLM_CACHE_DAYS=7

# --- news (R3): runs only in the `saley news` process (D151: and in the dev worker, main slot) ---
NEWS_EDITIONS=06:30,12:00,17:00,22:00
NEWS_USER_AGENT=SaleyNewsReader/3.0 (+https://membrane.social; contact news@membrane.social)
NEWS_ITEMS_PER_FETCH=50
NEWS_RAW_LOG=false
# D151: SALEY_ENV=dev and slot worker:main only. One edition at worker start when the last is over 6 h old.
NEWS_RUN_AT_START=true
NEWS_STALE_DAYS=3
SCORER_BACKEND=llm
SCORER_BATCH=40
SCORER_EDITION_CALL_CAP=6
OPENALEX_MAILTO=
ACTION_HINT_DAILY_CAP=40

# --- profile-link search (R3, D77). DuckDuckGo only by default (Q-R3-2). ---
# optional; set to use SearXNG first
SEARXNG_URL=
SEARCH_DAILY_CAP=50
SEARCH_MIN_GAP_SECONDS=5
SEARCH_CACHE_DAYS=30

# --- egress ---
EGRESS_ALLOWLIST=sheets.googleapis.com,www.googleapis.com,oauth2.googleapis.com,discord.com,api.anthropic.com,api.openalex.org,export.arxiv.org,news.google.com,imap.gmail.com,html.duckduckgo.com
EGRESS_BLOCKLIST=linkedin.com
EGRESS_RATE_PER_HOST_PER_MIN=30
HTTP_TIMEOUT_SECONDS=20

# --- web ---
WEB_PORT=8090
# D113: gate step 7 runs its own web here, against saley_test. Never the same as WEB_PORT.
GATE_PORT=8091
# D113: worker slot (D46). The gate sets worker:gate itself; keep worker:main here.
WORKER_SLOT=worker:main
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# D115: short=email,short=email. The short names the user; Saley never guesses it.
WEB_ALLOWED_EMAILS=
# D116: auto (google when client id + secret + allowlist are set, else mock) | google | mock.
# mock works only with SALEY_ENV=dev from this machine.
AUTH_PROVIDER=auto
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8090/auth/callback
# D114: how long a sign-in lasts (1 to 720 hours).
SESSION_HOURS=12
WEB_SESSION_SECRET=<REQUIRED: random 32+ chars>
DEV_USER_EMAIL=dev@membrane.local
DEV_USER_SHORT=trishi

# --- email sending (OFF until a decision; drafts only) ---
EMAIL_SEND_ENABLED=false
EMAIL_SINK_PATH=data/outbox
# D124: used only when EMAIL_SEND_ENABLED=true. SMTP_HOST must be on EGRESS_ALLOWLIST.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=
SMTP_APP_PASSWORD=<REQUIRED: app password of the EMAIL_FROM mailbox>

# --- mail (Membrane cc mailbox, read-only) ---
MAIL_IMAP_HOST=imap.gmail.com
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_POLL_MINUTES=10

# --- meeting notes (R2, D81): a Drive folder shared with the service account as Viewer ---
# The id is the text after /folders/ in the Drive URL. Empty = "notes: Drive not configured".
MEETING_NOTES_DRIVE_FOLDER_ID=
NOTES_SYNC_MINUTES=15
# Optional second source: a local folder of .md / .txt / .pdf files.
MEETING_NOTES_DIR=data/notes

# --- apollo (pipeline to build; off until then) ---
APOLLO_ENABLED=false
APOLLO_API_KEY=
APOLLO_MONTHLY_CREDIT_CAP=0

# --- RETIRED ---
# BOT_SHAPES_DRAFT  (R4, decision D127: the docs/09 shapes are live in test mode)
# OPENROUTER_API_KEY  (R1, decision D28: the LLM is the Anthropic API directly)
